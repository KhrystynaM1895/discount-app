{
  "name": "customer-tag-discount",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@shopify/shopify_function": "~2.0.0"
  },
  "codegen": {
    "schema": "schema.graphql",
    "documents": "src/**/*.graphql",
    "generates": {
      "./generated/api.ts": {
        "plugins": [
          "typescript",
          "typescript-operations"
        ]
      }
    },
    "config": {
      "omitOperationSuffix": true
    }
  }
}
